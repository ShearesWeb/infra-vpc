# Lambda upload zip files and dist/ dir
upload/
**/dist/

# Local .terraform directories and lock file
**/.terraform/*
.terraform.lock.hcl

# AWS credentials file (if any)
.aws
*/.aws

# .tfstate files
*.tfstate
*.tfstate.*

# Exclude all .tfvars files except config/
*.tfvars
*.tfvars.json
!infra/config/*.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Docs and logs
docs/
log/

# Agent artifacts
skills-lock.json
